# ─── OBRIGATÓRIO ──────────────────────────────────────────────────────
# Chave da Anthropic — sem ela todos os agentes retornam 401.
ANTHROPIC_API_KEY=sk-ant-api03-COLOQUE-SUA-CHAVE-AQUI


# ─── MODELOS ──────────────────────────────────────────────────────────
# Modelo padrão usado por TODOS os agentes (a menos que sobrescrito abaixo).
# Opções: claude-opus-4-7 | claude-sonnet-4-6 | claude-haiku-4-5
LEMMON_MODELO_PADRAO=claude-sonnet-4-6
LEMMON_MODELO_CONCIERGE=claude-haiku-4-5

# Modelo POR AGENTE (opcional — descomente pra sobrescrever).
# Recomendação: Opus pros "pensadores" (Otto e Salles); Sonnet pros operacionais.
# Custo extra estimado: +$0.05 a +$0.15 por sessão (vs ~$1 se trocar tudo pra Opus).
# LEMMON_MODELO_OTTO=claude-opus-4-7
# LEMMON_MODELO_SALLES=claude-opus-4-7
# LEMMON_MODELO_HEITOR=claude-sonnet-4-6
# LEMMON_MODELO_SONIA=claude-sonnet-4-6
# LEMMON_MODELO_AYA=claude-sonnet-4-6
# LEMMON_MODELO_RENATA=claude-sonnet-4-6
# LEMMON_MODELO_PEDRO_ABRAHAO=claude-sonnet-4-6


# ─── MULTI-TENANT (v1.46.2+) ──────────────────────────────────────────
# Namespace de TUDO (histórico, outputs, brand kit, audit, etc).
# Default: "default". Pra Hator usar: LEMMON_TENANT_ID=hator
# Inválido (com /, .., etc) vira "default" automaticamente.
# LEMMON_TENANT_ID=hator


# ─── CRIPTO-AT-REST (v1.48 A3a-003) ───────────────────────────────────
# Chave Fernet (32 bytes base64) — cifra brand kit, usuarios, backups.
# Pra gerar uma nova: .venv/bin/python -c "from core.tenant import gerar_chave; print(gerar_chave())"
# IMPORTANTE: GUARDE essa chave em local seguro. Sem ela, dados cifrados ficam
# ilegíveis pra sempre. Faça backup numa pasta DIFERENTE do disco principal.
# LEMMON_ENCRYPT_KEY=<chave-fernet-gerada-aqui>


# ─── AUTH (v1.46.2+) ──────────────────────────────────────────────────
# Token Bearer obrigatório pra rotas LGPD + treino Pedro Espelho em prod.
# Em dev (LEMMON_ENV=dev), pode rodar sem se LEMMON_ALLOW_*_DEV=1.
# Gere com: openssl rand -hex 32
# LEMMON_AUTH_TOKEN=<token-32bytes-hex>

# Ambiente: dev | production. Default: production (modo seguro).
# Só `dev` ativa os bypass LEMMON_ALLOW_*_DEV.
# LEMMON_ENV=dev
# LEMMON_ALLOW_TRAIN_DEV=1
# LEMMON_ALLOW_LGPD_DEV=1


# ─── LOGS (v1.48 A6a-006) ─────────────────────────────────────────────
# Nível: DEBUG | INFO | WARNING | ERROR
LEMMON_LOG_LEVEL=INFO

# Logs estruturados JSON (1 linha = 1 evento, jq-friendly) — recomendado em prod.
# Vazio/0 = texto humano (recomendado em dev).
# LEMMON_LOG_JSON=1


# ─── RATE LIMIT ───────────────────────────────────────────────────────
# Requests por minuto por IP. Default 60. Em dev local sobe pra 5000+.
# LEMMON_RATE_LIMIT_PER_MIN=60


# ─── CORS (T190.A6) ───────────────────────────────────────────────────
# Lista CSV de origins permitidos. Default = localhost:3000,4000,5173.
# Em produção: LEMMON_CORS_ORIGINS=https://lemmon.com.br,https://dashboard.lemmon.com.br
# LEMMON_CORS_ORIGINS=


# ─── TRANSCRIÇÃO DE ÁUDIO (T34) — OPCIONAL ────────────────────────────
# Para usar a feature "Falar briefing" (upload de áudio convertido em texto),
# crie uma chave em https://platform.openai.com/api-keys e descomente:
# OPENAI_API_KEY=sk-proj-COLOQUE-SUA-CHAVE-AQUI
# Sem essa chave o sistema funciona normalmente, só a transcrição fica desabilitada.


# ─── OPERAÇÃO ────────────────────────────────────────────────────────
# Diretório de backup (default ~/Documents/lemmon-backups).
# Roda via bin/backup.sh (cron diário recomendado às 3h).
# LEMMON_BACKUP_DIR=
